// This is the Prisma schema file for Andropedia.
// Compatible with PostgreSQL (Supabase, Neon, Railway, or local Postgres)

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MEMBER
  DOMAIN_ADMIN
  SUPER_ADMIN
}

enum Domain {
  TECHNICAL
  WEB
  PR
  RD
  DESIGN
  MEDIA
}

// Title on the Our Team page. Separate from `Role`, which controls portal permissions.
enum ClubPosition {
  PRESIDENT
  VICE_PRESIDENT
  CHIEF        // chief of the user's `domain`; listed in the Core team
  LEAD
  CO_LEAD
  MEMBER
}

enum TaskStatus {
  SUBMITTED
  EVALUATED
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  // Login is by register number. The password is derived from it (see lib/auth.ts); only a hash is stored.
  registerNo      String?        @unique
  passwordHash    String?
  // True while the password is still the register number (or one an admin handed out): the member must choose their own
  // before the portal lets them do anything else.
  mustChangePassword Boolean     @default(false)
  role            Role           @default(MEMBER)
  domain          Domain
  avatar          String?
  bio             String?
  github          String?
  linkedin        String?
  instagram       String?
  portfolio       String?
  points          Int            @default(0)
  tasksCompleted  Int            @default(0)
  streakWeeks     Int            @default(0)
  isActive        Boolean        @default(true)
  position        ClubPosition   @default(MEMBER)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tasks           Task[]         @relation("UserTasks")
  evaluationsDone Evaluation[]   @relation("AdminEvaluations")
  sessions        Session[]
  passwordResets  PasswordReset[]
  photo           MemberPhoto?
  attendance      AttendanceRecord[]
}

// Profile picture uploaded by a super admin from the portal (already resized in the browser).
// Kept apart from `User` so listing members never loads image bytes.
model MemberPhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
}

// One-time "forgot password" links. Only the SHA-256 of the emailed token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Week {
  id                String       @id @default(cuid())
  weekNumber        Int          @unique
  title             String
  theme             String
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean      @default(false)
  promptDescription String?
  createdAt         DateTime     @default(now())

  tasks             Task[]
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation("UserTasks", fields: [userId], references: [id], onDelete: Cascade)
  weekId        String
  week          Week         @relation(fields: [weekId], references: [id])
  domain        Domain
  title         String
  description   String
  githubUrl     String?
  liveUrl       String?
  figmaUrl      String?
  notes         String?
  status        TaskStatus   @default(SUBMITTED)
  submittedAt   DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  evaluation    Evaluation?

  @@unique([userId, weekId]) // one submission per member per week (re-submitting edits it)
  @@index([userId])
  @@index([weekId])
  @@index([status])
}

model Evaluation {
  id              String       @id @default(cuid())
  taskId          String       @unique
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  adminId         String
  admin           User         @relation("AdminEvaluations", fields: [adminId], references: [id])
  score           Int          // 0 to 100
  technicalDepth  Int?         // 0 to 25
  innovation      Int?         // 0 to 25
  completion      Int?         // 0 to 25
  documentation   Int?         // 0 to 25
  feedback        String
  evaluatedAt     DateTime     @default(now())
}

// Server-side login sessions. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// One-time email login codes. No longer used: login is by register number. Safe to drop once every deployment runs the new login.
model LoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

// Permanent record of every recruitment application. The database is the source of truth; the
// Google Sheet (if configured) is a convenience mirror. Holds personal data: super admins only.
model Application {
  id            String    @id @default(cuid())
  reference     String    @unique
  emailKey      String    @unique // canonical email (Gmail dots/+tags removed): one application per person
  name          String
  registerNo    String
  department    String
  year          String
  phone         String
  email         String
  profile       String    // LinkedIn / GitHub / Instagram link or handle
  domain        String    // exactly one of: technical | web | design | media | pr
  answers       Json      // question id -> answer, for the universal questions and the chosen domain (see lib/recruitment/questions.ts)
  consent       Boolean   @default(true)
  status        String    @default("new") // new | shortlisted | accepted | rejected
  emailSentAt   DateTime?
  sheetSyncedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([domain])
}

// Who changed what: grading, week changes, role and account changes. No foreign key on purpose,
// so entries survive if an account is later removed.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String   // e.g. "evaluation.save", "week.update", "member.update"
  target    String   // id of the thing changed
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

// Club events (hackathons, workshops, contests). Managed by super admins; the public page lists
// published ones and lets visitors RSVP.
model Event {
  id               String      @id @default(cuid())
  title            String
  type             String      // short label, e.g. "Hackathon", "Workshop"
  description      String
  location         String
  startsAt         DateTime
  endsAt           DateTime?
  capacity         Int?        // null = unlimited seats (or teams, for team events)
  teamMin          Int?        // both set = team event: teams of teamMin..teamMax people register together
  teamMax          Int?
  prize            String?
  isPublished      Boolean     @default(false)
  registrationOpen Boolean     @default(true)
  dateTbc          Boolean     @default(false) // the real date is not known yet: shown as "Date to be announced" and treated as past
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  rsvps            EventRsvp[]
  images           EventImage[]
  attendance       AttendanceSession?

  @@index([startsAt])
}

// Photos a super admin uploads for an event from the portal (already resized in the browser).
// Listings select only `id` so image bytes are never loaded with the event.
model EventImage {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([eventId, position])
}

model EventRsvp {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  email       String    // as typed, trimmed
  emailKey    String    // canonical form (Gmail dots/+tags removed): one seat per person per event
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())
  teamName    String?   // set for team registrations; name/email above are then the team leader's
  members     EventMember[]

  @@unique([eventId, emailKey])
  @@index([eventId])
}

// One person on a team registration (the leader included). A person can be on only one team per event.
model EventMember {
  id         String    @id @default(cuid())
  rsvpId     String
  rsvp       EventRsvp @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  eventId    String
  isLeader   Boolean   @default(false)
  name       String
  mobile     String
  email      String
  emailKey   String
  dept       String
  section    String
  year       String
  registerNo String

  @@unique([eventId, emailKey])
  @@unique([eventId, registerNo])
  @@index([rsvpId])
}

// A meeting whose attendance is taken by hand or from a CSV: an event, or a regular club hour.
// An event has at most one session (created the first time attendance is marked for it).
enum AttendanceKind {
  EVENT
  CLUB_HOUR
}

model AttendanceSession {
  id          String           @id @default(cuid())
  kind        AttendanceKind
  title       String
  heldOn      DateTime
  hours       Float?           // club hours only: how long the session ran
  eventId     String?          @unique
  event       Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdById String           // no foreign key on purpose, like AuditLog
  createdAt   DateTime         @default(now())
  records     AttendanceRecord[]

  @@index([heldOn])
}

// One member present at one session.
model AttendanceRecord {
  id         String            @id @default(cuid())
  sessionId  String
  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  markedById String
  createdAt  DateTime          @default(now())

  @@unique([sessionId, userId])
  @@index([userId])
}

// Fixed-window counters for rate limiting, shared by every server instance (see lib/rate-limit-db.ts).
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

// Club projects shown on /projects. Managed by super admins; only published ones are public.
model Project {
  id          String   @id @default(cuid())
  title       String
  domain      String   // Web | Technical | R&D | Design | Media | PR
  description String
  tags        String[]
  github      String?
  live        String?
  status      String   @default("In progress") // free label, e.g. "Live & Open Source"
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
}
