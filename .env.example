# Copy to .env (never commit .env). See docs/BACKEND_PRD.md section 2.7.1.

# --- Recruitment: Google Sheets API ---
# Create a service account in Google Cloud, enable the Sheets API, then share the
# sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor. Row 1 of the tab is written automatically
# (40 columns, see docs/applicants-sheet-headers.csv). Admins may add their own working columns
# to the right of email_status.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
RECRUITMENT_SHEET_ID=
RECRUITMENT_SHEET_TAB=Applications

# Simpler alternative to the service account: an Apps Script web app bound to the sheet
# (see docs/apps-script-sheet-webhook.gs). When both are set, the site writes rows through it.
RECRUITMENT_SHEET_WEBHOOK_URL=
RECRUITMENT_SHEET_WEBHOOK_SECRET=

# --- Recruitment: confirmation email (SMTP) ---
# Gmail: SMTP_HOST=smtp.gmail.com, use an App Password (never the account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Andropedia <club-address@example.com>"
EMAIL_REPLY_TO=

# --- Login ---
# Secret mixed into every member password hash. REQUIRED in production, and changing it invalidates all passwords. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Database (Supabase Postgres via Prisma) ---
# Supabase dashboard -> Connect.
# DATABASE_URL is the app's runtime connection. On serverless hosting (Vercel, Netlify) it MUST be the pooled
# "Transaction pooler" string (host ...pooler.supabase.com, port 6543), because every server instance opens its own
# connections and the direct connection runs out fast. Add ?sslmode=require. /api/health warns if it is the direct one.
DATABASE_URL=
# DIRECT_URL is the direct connection (db.<ref>.supabase.co, port 5432). Used ONLY by `npm run db:deploy` (migrations).
DIRECT_URL=
# Connections each server instance may open (default 5 in production, 10 locally). Keep (instances x this) under the database limit.
PG_POOL_MAX=

# --- Member sheet (Google Form responses with the new members) ---
# This sheet holds personal data (register numbers, phone numbers, dates of birth). It must be PRIVATE:
# share it ONLY with GOOGLE_SERVICE_ACCOUNT_EMAIL (Viewer is enough) and never as "anyone with the link".
# The id is in the sheet's URL: docs.google.com/spreadsheets/d/<MEMBER_SHEET_ID>/edit
MEMBER_SHEET_ID=
# Tab id (the number after gid= in the URL) of the form-responses tab. Empty = the first tab.
MEMBER_SHEET_GID=
# Local testing only: read the sheet without credentials. Needs a world-readable sheet, so keep it off (false) in production.
MEMBER_SHEET_ALLOW_PUBLIC=false

# --- Recruitment cycle (all optional; changes take effect on the next request/restart) ---
# Manual kill switch: set to false to stop accepting applications immediately.
RECRUITMENT_OPEN=true
# Schedule, ISO dates WITH a timezone, e.g. 2026-10-20T23:59:00+05:30. Leave empty for no limit.
RECRUITMENT_OPENS_AT=
RECRUITMENT_CLOSES_AT=

# --- Operations ---
# Enables /api/cron/recruitment-flush and the detailed /api/health. Generate like AUTH_SECRET.
CRON_SECRET=
# Public URL of the site (https://your-domain), used for password-reset links, the sitemap and share previews. REQUIRED in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# How many proxies sit in front of the app (default 1). Rate limits use the address the closest trusted proxy saw, because
# anyone can send a fake X-Forwarded-For. On Vercel this is handled for you.
TRUSTED_PROXY_HOPS=1
# Invite link for the club WhatsApp community, shown on the application success screen. Leave blank to hide the button.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
